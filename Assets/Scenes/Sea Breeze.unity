  - "{\r\n\"langName\": \"\u65E5\u672C\u8A9E\",\r\n\"langCode\": \"jp\",\r\n\"langFont\":
    \"NotoSansJP\",\r\n\"-----comment-Menu-----\": \"For Menu Plate Under Here\",\r\n\"info\":
    \"\u60C5\u5831\",\r\n\"infoQR\": \"\u5F8C\u308D\u306BQR\u30B3\u30FC\u30C9\u304C\u3042\u308A\u307E\u3059\",\r\n\"needDLC\":
    \"DLC\u304C\u5FC5\u8981\u3067\u3059\",\r\n\"commingSoon\": \"\u8FD1\u65E5\u516C\u958B\",\r\n\"coffee\":
    \"\u30B3\u30FC\u30D2\u30FC\",\r\n\"ade\": \"\u30A8\u30FC\u30C9\",\r\n\"bubbleTea\":
    \"\uF9FE\",\r\n\"espresso\": \"\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\",\r\n\"espressoConPanna\":
    \"\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\u30B3\u30F3\u30D1\u30CA\",\r\n\"americano\":
    \"\u30A2\u30E1\u30EA\u30AB\u30FC\u30CE\",\r\n\"latte\": \"\u30E9\u30C6\",\r\n\"cappuccino\":
    \"\u30AB\u30D7\u30C1\u30FC\u30CE\",\r\n\"cafeMocha\": \"\u30AB\u30D5\u30A7\u30E2\u30AB\",\r\n\"cafeMochaArt\":
    \"\u30AB\u30D5\u30A7\u30E2\u30AB\uFF08\u30A2\u30FC\u30C8\uFF09\",\r\n\"caramelMacchiato\":
    \"\u30AD\u30E3\u30E9\u30E1\u30EB\u30DE\u30AD\u30A2\u30FC\u30C8\",\r\n\"-----comment-Machine-----\":
    \"For Espresso Machine Under Here\",\r\n\"machine_filterNeed\": \"\u30DD\u30FC\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u5FC5\u8981\",\r\n\"machine_filterNeedTamped\":
    \"\u30BF\u30F3\u30D1\u3055\u308C\u305F\\n\u30DD\u30FC\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u5FC5\u8981\",\r\n\"machine_filterPlaced\":
    \"\u30D5\u30A3\u30EB\u30BF\u30FC\\n\u8A2D\u7F6E\u6E08\u307F\",\r\n\"machine_filterChange\":
    \"\u30D5\u30A3\u30EB\u30BF\u30FC\\n\u4EA4\u63DB\u5FC5\u8981\",\r\n\"machine_cupNeed\":
    \"\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\\n\u30AB\u30C3\u30D7\u5FC5\u8981\",\r\n\"machine_cupNeedEmpty\":
    \"\u7A7A\u306E\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\\n\u30AB\u30C3\u30D7\u5FC5\u8981\",\r\n\"machine_extracting\":
    \"\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\\n\u62BD\u51FA\u4E2D\",\r\n\"machine_PitcherNeed\":
    \"\u725B\u4E73\u5165\u308A\\n\u30D4\u30C3\u30C1\u30E3\u30FC\u5FC5\u8981\",\r\n\"machine_PitcherPlaced\":
    \"\u30D4\u30C3\u30C1\u30E3\u30FC\\n\u8A2D\u7F6E\u6E08\u307F\",\r\n\"machine_PitcherChange\":
    \"\u30D4\u30C3\u30C1\u30E3\u30FC\\n\u4EA4\u63DB\u5FC5\u8981\",\r\n\"machine_frothLatte\":
    \"\u30E9\u30C6\u7528\\n\u6CE1\u7ACB\u3066\u30E2\u30FC\u30C9\",\r\n\"machine_frothCappu\":
    \"\u30AB\u30D7\u30C1\u30FC\u30CE\u7528\\n\u6CE1\u7ACB\u3066\u30E2\u30FC\u30C9\",\r\n\"machine_frothing\":
    \"\u30DF\u30EB\u30AF\u6CE1\u7ACB\u3066\u4E2D\",\r\n\"machine_waterOn\": \"\u304A\u6E6F\u4F5C\u52D5\u4E2D\",\r\n\"machine_waterOff\":
    \"\u304A\u6E6F\u505C\u6B62\u4E2D\",\r\n\"-----comment-Pad-----\": \"For Pad Under
    Here\",\r\n\"tutorial\": \"\u4F7F\u3044\u65B9\",\r\n\"extractingEspresso\": \"\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\u3092\u62BD\u51FA\u3059\u308B\",\r\n\"extractingEspresso_1_title\":
    \"1. \u8C46\u306E\u633D\u304D\u65B9\",\r\n\"extractingEspresso_1_content\": \"\u7A7A\u306E\u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u3092\u30B0\u30E9\u30A4\u30F3\u30C0\u30FC\u306B\u8A2D\u7F6E\u3057\u307E\u3059\u3002\\n\u30B0\u30E9\u30A4\u30F3\u30C0\u30FC\u306E\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u8C46\u3092\u633D\u304D\u307E\u3059\u3002\",\r\n\"extractingEspresso_2_title\":
    \"2. \u30BF\u30F3\u30D4\u30F3\u30B0\",\r\n\"extractingEspresso_2_content\": \"\u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u3092\u30B0\u30E9\u30A4\u30F3\u30C0\u30FC\u304B\u3089\u5916\u3057\u3066\u3001\u30BF\u30F3\u30D1\u30FC\u3067\u8C46\u3092\u62BC\u3057\u56FA\u3081\u307E\u3059\u3002\",\r\n\"extractingEspresso_3_title\":
    \"3. \u62BD\u51FA\",\r\n\"extractingEspresso_3_content\": \"\u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u3092Use\u3057\u3066\u62BD\u51FA\u3059\u308B\u6570\uFF08\uFF11\u30AB\u30C3\u30D7\u304B\uFF12\u30AB\u30C3\u30D7\uFF09\u3092\u9078\u629E\u3057\u307E\u3059\u3002\\n\u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u3092\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\u30DE\u30B7\u30FC\u30F3\u306B\u8A2D\u7F6E\u3057\u307E\u3059\u3002\\n\u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u306E\u4E0B\u306B\u8868\u793A\u3055\u308C\u3066\u3044\u308B\u5F71\u306B\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\u30AB\u30C3\u30D7\u8A2D\u7F6E\u3057\u307E\u3059\u3002\\n\u30AB\u30C3\u30D7\u3092\u8A2D\u7F6E\u5F8C\u3001\u5DE6\u304B\u3089\u4E09\u756A\u76EE\u306E\u62BD\u51FA\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\u3092\u62BD\u51FA\u3057\u307E\u3059\u3002\",\r\n\"extractingEspresso_4_title\":
    \" 4. \u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u306E\u6383\u9664\",\r\n\"extractingEspresso_4_content\":
    \"\u30A8\u30B9\u30D7\u30EC\u30C3\u30BD\u3092\u62BD\u51FA\u3057\u305F\u5F8C\u3001\u30DD\u30EB\u30BF\u30D5\u30A3\u30EB\u30BF\u30FC\u3092\u30CE\u30C3\u30AF\u30DC\u30C3\u30AF\u30B9\u5F53\u3066\u3066\u3001\u30D5\u30A3\u30EB\u30BF\u30FC\u5185\u3092\u7A7A\u306B\u3057\u307E\u3059\u3002\",\r\n\"frothingMilk\":
    \"\u30DF\u30EB\u30AF\u3092\u6CE1\u7ACB\u3066\u308B\",\r\n\"frothingMilk_1_title\":
    \"1. \u30DF\u30EB\u30AF\u3092\u6CE8\u3050\",\r\n\"frothingMilk_1_content\": \"\u725B\u4E73\u30D1\u30C3\u30AF\u3092Use\u3057\u3066\u30AD\u30E3\u30C3\u30D7\u3092\u5916\u3057\u307E\u3059\u3002\\n\u7A7A\u306E\u30DF\u30EB\u30AF\u30D4\u30C3\u30C1\u30E3\u30FC\u306B\u30DF\u30EB\u30AF\u3092\u6CE8\u304E\u307E\u3059\u3002\",\r\n\"frothingMilk_2_title\":
